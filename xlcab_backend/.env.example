# Copier en .env et remplir avant de lancer `npm run start:dev`

DATABASE_URL="postgresql://user:password@localhost:5432/xlcab?schema=public"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Générer des secrets forts distincts pour l'access et le refresh token :
# openssl rand -base64 64
JWT_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"

PORT=3000

# "true" uniquement en production derrière Nginx (IP réelle via X-Forwarded-For).
# Laisser à "false" en développement local.
TRUST_PROXY="false"

# Module 3 (Tracking WebSocket) : origines navigateur autorisées, séparées
# par des virgules (portails React corporate + admin). Les apps mobiles
# n'envoient pas d'Origin et ne sont pas concernées.
CORS_ORIGINS="http://localhost:5173"

# Clé Google SERVEUR (Routes API) pour le calcul des distances et des prix.
# Distincte de la clé embarquée dans l'app mobile (Maps SDK + Places),
# et restreinte par IP au serveur de production.
GOOGLE_MAPS_API_KEY=""

# Module 8 : dossier PRIVÉ des documents chauffeurs en développement
# (jamais servi par l'API, ignoré par Git). En production : S3 privé.
UPLOAD_DIR="storage/private"

# Module 10 : clé AES-256 (32 octets en base64) qui chiffre les secrets de
# double authentification. Générer : openssl rand -base64 32
# La changer rend toutes les 2FA existantes illisibles (à réactiver).
TWO_FACTOR_ENC_KEY=""

# Paiements Stripe (prépaiement des courses passager). Clés du compte
# Stripe (mode test : sk_test_… / whsec_… de `stripe listen`).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Version d'API des clés éphémères attendue par le SDK mobile (PaymentSheet).
STRIPE_MOBILE_API_VERSION="2024-06-20"

# Version en vigueur des CGU / politique de confidentialité (consentement
# à l'inscription). Doit correspondre à termsVersion de l'app mobile.
TERMS_VERSION="2026-10-01"

# Planificateur (tâches minute, src/scheduler) :
# recherche de chauffeur lancée à T − DISPATCH_LEAD_MIN pour une course
# programmée ; réservation non payée annulée après UNPAID_BOOKING_EXPIRY_MIN.
DISPATCH_LEAD_MIN=180
UNPAID_BOOKING_EXPIRY_MIN=30
# Commission XLCAB sur les courses (revenus chauffeur, sur le HT).
DRIVER_COMMISSION_PERCENT=10
# SCHEDULER_ENABLED=false   # désactive les tâches (ex. instance secondaire)

# À ajouter aux modules suivants :
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

# ── Factures légales (src/invoices) ───────────────────────────────────
# Mentions OBLIGATOIRES du vendeur, figées sur chaque facture émise. Tant
# qu'elles manquent, les factures portent « [à compléter] » et le dashboard
# admin affiche une alerte. À fournir par XLCAB France SAS.
INVOICE_SELLER_NAME="XLCAB France SAS"
INVOICE_SELLER_LEGAL_FORM=""        # ex. SAS
INVOICE_SELLER_CAPITAL=""           # ex. 10 000 €
INVOICE_SELLER_ADDRESS=""           # adresse du siège
INVOICE_SELLER_SIREN=""
INVOICE_SELLER_RCS=""               # ville du greffe, ex. Paris
INVOICE_SELLER_VAT_NUMBER=""        # FRxx…
INVOICE_SELLER_REVTC=""             # n° d'inscription au registre VTC
INVOICE_SELLER_EMAIL="facturation@xlcab.com"
# Compte à créditer, imprimé sur les factures à régler par virement (entreprises,
# pénalités). Un IBAN absent ou dont la clé est fausse n'est jamais imprimé.
INVOICE_SELLER_IBAN=""              # ex. FR76 3000 6000 0112 3456 7890 189
INVOICE_SELLER_BIC=""               # facultatif, ex. AGRIFRPP
# Mention imprimée quand le transport de personnes est à 0 % de TVA (à faire valider).
INVOICE_PASSENGER_VAT_MENTION="Transport de personnes : exonération de TVA (article 261-4-4° du CGI)."
# Adresse publique de l'API (liens de téléchargement des factures depuis l'app).
PUBLIC_API_URL="https://api.xlcab.com"

# ── Sécurité (src/security) ───────────────────────────────────────────
# Limitation de débit globale (Partie 8) : par utilisateur et par IP, par minute.
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_IP_PER_MINUTE=1000
# En production (NODE_ENV=production), l'API REFUSE DE DÉMARRER si : secrets
# JWT < 32 caractères, identiques ou d'exemple ; TWO_FACTOR_ENC_KEY absente ;
# CORS_ORIGINS absent ou non https ; PUBLIC_API_URL non https ; REDIS_PASSWORD
# vide ; Stripe configuré sans STRIPE_WEBHOOK_SECRET.
